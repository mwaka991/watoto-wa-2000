# PalmPesa API Configuration
PALMPESA_API_TOKEN=your_palmpesa_api_token_here

# Application Base URL (For Vercel, use your production domain)
# During development: http://localhost:4009
# For Vercel production: https://your-project-name.vercel.app
APP_BASE_URL=https://your-project-name.vercel.app

# Server Port (Vercel will override this)
PORT=3000
